        </mxCell>
        <mxCell id="s41" value="Notación de Chen · derivado de backend/prisma/schema.prisma · 28 de octubre de 2026" style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=18;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="143" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s42" value="Rectángulo: entidad    /    Rombo: relación    /    Óvalo: atributo    /    Subrayado: identificador" style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=18;align=left;fontColor=#233247;" vertex="1" parent="1">
          <mxGeometry x="70" y="189" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s43" value="(mín,máx) junto a cada entidad: participaciones de esa instancia. N = muchas. Línea doble = obligatoria. ? = atributo opcional." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=17;align=left;fontColor=#233247;" vertex="1" parent="1">
          <mxGeometry x="70" y="227" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s44" value="Las entidades en verde son referencias: su definición completa aparece en otra lámina." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=16;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="265" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s45" value="Cada evento se vincula obligatoriamente a una sucursal y una zona coherentes entre sí." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=17;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="1729" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s46" value="Una recepción técnica puede no tener evento; varios reenvíos pueden vincularse al mismo evento." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=17;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="1759" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s47" value="El estado de recepción es técnico. El estado de EventoSucursal corresponde a la gestión operativa." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=17;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="1789" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s48" value="04-eventos-recepcion  ·  Chen" style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=15;align=right;fontColor=#56657a;" vertex="1" parent="1">
