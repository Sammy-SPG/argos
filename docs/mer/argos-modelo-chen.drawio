        </mxCell>
        <mxCell id="s82" value="Sucursales, asignación y territorio" style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=36;align=left;fontColor=#233247;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="83" width="2060" height="54" as="geometry" />
        </mxCell>
        <mxCell id="s83" value="Notación de Chen · derivado de backend/prisma/schema.prisma · 28 de octubre de 2026" style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=18;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="143" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s84" value="Rectángulo: entidad    /    Rombo: relación    /    Óvalo: atributo    /    Subrayado: identificador" style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=18;align=left;fontColor=#233247;" vertex="1" parent="1">
          <mxGeometry x="70" y="189" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s85" value="(mín,máx) junto a cada entidad: participaciones de esa instancia. N = muchas. Línea doble = obligatoria. ? = atributo opcional." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=17;align=left;fontColor=#233247;" vertex="1" parent="1">
          <mxGeometry x="70" y="227" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s86" value="Las entidades en verde son referencias: su definición completa aparece en otra lámina." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=16;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="265" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s87" value="UsuarioSucursal es una entidad de asociación con identidad y fechas propias; usuarioId es único." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=17;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="2319" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s88" value="Cada usuario tiene 0 o 1 asignación actual. Una sucursal admite 0 a N asignaciones." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=17;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="2349" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s89" value="Estado y Municipio son catálogos independientes en este esquema: no se infiere una relación entre ellos." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=17;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="2379" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s90" value="02-sucursales-territorio  ·  Chen" style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=15;align=right;fontColor=#56657a;" vertex="1" parent="1">
