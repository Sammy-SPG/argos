        <mxCell id="s67" value="ARGOS  /  MODELO ENTIDAD–RELACIÓN" style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=19;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="41" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s68" value="Atención, historial y resolución" style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=36;align=left;fontColor=#233247;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="83" width="2060" height="54" as="geometry" />
        </mxCell>
        <mxCell id="s69" value="Notación de Chen · derivado de backend/prisma/schema.prisma · 28 de octubre de 2026" style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=18;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="143" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s70" value="Rectángulo: entidad    /    Rombo: relación    /    Óvalo: atributo    /    Subrayado: identificador" style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=18;align=left;fontColor=#233247;" vertex="1" parent="1">
          <mxGeometry x="70" y="189" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s71" value="(mín,máx) junto a cada entidad: participaciones de esa instancia. N = muchas. Línea doble = obligatoria. ? = atributo opcional." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=17;align=left;fontColor=#233247;" vertex="1" parent="1">
          <mxGeometry x="70" y="227" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s72" value="Las entidades en verde son referencias: su definición completa aparece en otra lámina." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=16;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="265" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s73" value="Un evento y un usuario conservan N atenciones históricas, pero como máximo una atención vigente cada uno." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=17;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="2059" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s74" value="Cada atención pertenece a una sesión y un usuario; la coherencia entre ambos es una regla adicional." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=17;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="2089" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s75" value="En el historial, usuario y atención son opcionales. Usuario nulo identifica una acción automática." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=17;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="2119" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s76" value="Cada evento tiene como máximo una resolución; cada resolución tiene un usuario responsable." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=17;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="2149" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s77" value="05-atencion-historial  ·  Chen" style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=15;align=right;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="2173" width="2060" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
