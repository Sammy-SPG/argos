        </mxCell>
        <mxCell id="s75" value="PlantillaPermiso comparte el dominio RolUsuario; Prisma no declara vínculos con otras entidades." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=17;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="2309" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s76" value="Un usuario puede conservar varias sesiones, permisos y bloqueos históricos." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=17;align=left;fontColor=#56657a;" vertex="1" parent="1">
