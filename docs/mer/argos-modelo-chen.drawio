        <mxCell id="s40" value="Eventos y recepción de señales" style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=36;align=left;fontColor=#233247;fontStyle=1;" vertex="1" parent="1">
