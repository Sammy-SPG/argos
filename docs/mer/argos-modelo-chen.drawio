        <mxCell id="s51" value="ARGOS  /  MODELO ENTIDAD–RELACIÓN" style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=19;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="41" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s52" value="Infraestructura de monitoreo" style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=36;align=left;fontColor=#233247;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="83" width="2060" height="54" as="geometry" />
        </mxCell>
        <mxCell id="s53" value="Notación de Chen · derivado de backend/prisma/schema.prisma · 28 de octubre de 2026" style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=18;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="143" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s54" value="Rectángulo: entidad    /    Rombo: relación    /    Óvalo: atributo    /    Subrayado: identificador" style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=18;align=left;fontColor=#233247;" vertex="1" parent="1">
          <mxGeometry x="70" y="189" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s55" value="(mín,máx) junto a cada entidad: participaciones de esa instancia. N = muchas. Línea doble = obligatoria. ? = atributo opcional." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=17;align=left;fontColor=#233247;" vertex="1" parent="1">
          <mxGeometry x="70" y="227" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s56" value="Las entidades en verde son referencias: su definición completa aparece en otra lámina." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=16;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="265" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s57" value="Toda zona pertenece a una sucursal; pertenecer a una partición es opcional." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=17;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="1629" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s58" value="Cuando la zona tiene partición, ambas deben pertenecer a la misma sucursal (regla adicional)." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=17;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="1659" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s59" value="Cámaras y sensores se asocian a la zona, sin una relación directa inventada con el evento." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=17;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="1689" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s60" value="03-infraestructura  ·  Chen" style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=15;align=right;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="1743" width="2060" height="30" as="geometry" />
        </mxCell>
      </root>
