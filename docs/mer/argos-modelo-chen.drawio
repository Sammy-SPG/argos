        <mxCell id="s91" value="Notación de Chen · derivado de backend/prisma/schema.prisma · 28 de octubre de 2026" style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=18;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="143" width="2800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s92" value="Rectángulo: entidad    /    Rombo: relación    /    Óvalo: atributo    /    Subrayado: identificador" style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=18;align=left;fontColor=#233247;" vertex="1" parent="1">
          <mxGeometry x="70" y="189" width="2800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s93" value="(mín,máx) junto a cada entidad: participaciones de esa instancia. N = muchas. Línea doble = obligatoria. ? = atributo opcional." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=17;align=left;fontColor=#233247;" vertex="1" parent="1">
          <mxGeometry x="70" y="227" width="2800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s94" value="Vista resumida: selección de entidades, atributos y relaciones. Las láminas 01 a 06 contienen el detalle completo." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=17;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="2319" width="2800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s95" value="La relación «se asigna a» resume UsuarioSucursal; conserva 0 o 1 sucursal por usuario y 0 a N usuarios por sucursal." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=17;align=left;fontColor=#56657a;" vertex="1" parent="1">
