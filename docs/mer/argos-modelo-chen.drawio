        <mxCell id="s60" value="Notación de Chen · derivado de backend/prisma/schema.prisma · 28 de octubre de 2026" style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=18;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="143" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s61" value="Rectángulo: entidad    /    Rombo: relación    /    Óvalo: atributo    /    Subrayado: identificador" style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=18;align=left;fontColor=#233247;" vertex="1" parent="1">
          <mxGeometry x="70" y="189" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s62" value="(mín,máx) junto a cada entidad: participaciones de esa instancia. N = muchas. Línea doble = obligatoria. ? = atributo opcional." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=17;align=left;fontColor=#233247;" vertex="1" parent="1">
          <mxGeometry x="70" y="227" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s63" value="Las entidades en verde son referencias: su definición completa aparece en otra lámina." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=16;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="265" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s64" value="Una notificación tiene evento, destinatario y dispositivo obligatorios; el escalamiento es opcional." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=17;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="1709" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s65" value="No se repite la combinación de evento, dispositivo y destinatario. Los intentos se numeran por aviso." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=17;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="1739" width="2060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s66" value="La coherencia del destinatario con la sesión del dispositivo y del evento con la escalada exige validación." style="fontFamily=Arial;fontColor=#233247;whiteSpace=wrap;html=1;shape=text;strokeColor=none;fillColor=none;fontSize=17;align=left;fontColor=#56657a;" vertex="1" parent="1">
          <mxGeometry x="70" y="1769" width="2060" height="30" as="geometry" />
        </mxCell>
