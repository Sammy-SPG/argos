NODE_ENV="development"

DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
DATABASE_USER="user"
DATABASE_PASSWORD="password"
DATABASE_NAME="database"
DATABASE_HOST="localhost"
DATABASE_PORT="3306"

# Firma y duración de las sesiones; JWT_EXPIRES_IN se expresa en segundos.
JWT_SECRET=""
JWT_EXPIRES_IN="28800"
JWT_ISSUER="argos-api"
JWT_AUDIENCE="argos-clientes"

# Redis: la contraseña se comparte con el contenedor local; genera una propia.
REDIS_URL="redis://127.0.0.1:6379/0"
REDIS_PASSWORD=""
REDIS_KEY_PREFIX="argos:development:v1"
# TTL en segundos; tiempos de conexión y comandos en milisegundos.
REDIS_TTL_SECONDS="3600"
REDIS_CONNECT_TIMEOUT_MS="5000"
REDIS_COMMAND_TIMEOUT_MS="2000"
# Puerto publicado por Docker Compose; ajústalo también en REDIS_URL si cambia.
REDIS_LOCAL_PORT="6379"
